# Harbor Flights - Environment Variables

# ── Airline Credentials ──
# ANA Mileage Club credentials (required for ANA scraper)
ANA_USERNAME=
ANA_PASSWORD=

# Singapore Airlines KrisFlyer (required for SQ scraper)
SQ_KRISFLYER_ID=
SQ_KRISFLYER_PASSWORD=

# British Airways Executive Club (required for BA scraper)
BA_EXEC_CLUB_NUMBER=
BA_EXEC_CLUB_PASSWORD=

# Aeroplan / Air Canada (required for United via Aeroplan scraper)
AEROPLAN_USERNAME=
AEROPLAN_PASSWORD=

# United MileagePlus (optional — needed if united.com requires login for award search)
UNITED_USERNAME=        # MileagePlus number or email
UNITED_PASSWORD=

# Turkish Airlines API (register at developer.apim.turkishairlines.com)
TK_API_KEY=               # Turkish Airlines API key
TK_API_SECRET=            # Turkish Airlines API secret

# ── Daemon Configuration ──
# Path to shared web cache JSON for frontend display
WEB_CACHE_PATH=

# Comma-separated SCRAPER_REGISTRY keys the daemon is allowed to run
# (e.g. DAEMON_SCRAPERS=aa,flying-blue,jetblue). Empty/unset = all
# non-blocked active registry entries.
DAEMON_SCRAPERS=

# Days between sampled search dates (default: 14)
DATE_SAMPLING_DAYS=14

# Base directory for all data files (default: ./data)
DATA_DIR=

# ── Web Frontend ──
# Max age (hours) of flight_cache rows shown as current deals (default: 48)
DEAL_MAX_AGE_HOURS=48

# ── Caching ──
# Directory for disk-backed scraper cache (leave empty for in-memory only)
SCRAPER_CACHE_DIR=

# ── Database ──
# PostgreSQL connection URL (from Terraform output or local dev)
# Example: postgresql://flightadmin:password@flight-points.xxxx.us-east-1.rds.amazonaws.com:5432/flight_points?sslmode=require
DATABASE_URL=

# Set to "false" to disable SSL (for local dev only)
# PG_SSL=false

# ── Proxy ──
# SOCKS5 proxy for anti-detect browsers (e.g., socks5://127.0.0.1:1080)
PROXY_URL=

# ── Harbor SSE Proxy (for Vercel -> Harbor live search) ──
# URL of the Harbor Express server (required for live search SSE proxy)
# Example: http://150.136.249.186:3000 or http://harbor.local:3000
HARBOR_URL=

# Daemon staleness watchdog (src/flights/staleness-check.ts)
STALENESS_THRESHOLD_MIN=90
STALENESS_ALERT_CONTACT=

# Better Auth (Phase 6) — generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://flight-points.vercel.app

# Vision-based anomaly classifier (src/flights/vision-verify.ts) — optional.
# When set, the canary classifies WHY a scraper returned 0 (blocked/login/DOM-drift/empty).
ANTHROPIC_API_KEY=
CANARY_VISION=0

# Proxy difficulty routing (src/flights/net/proxy-router.ts). DATACENTER defaults to PROXY_URL.
# Set residential/mobile to route Akamai/auth carriers off the shared datacenter IP.
DATACENTER_PROXY_URL=
RESIDENTIAL_PROXY_URL=
MOBILE_PROXY_URL=

# ── Frontier roadmap flags (all opt-in; unset = today's proven path) ──
# M1: fan scrapes through a priority job queue with bounded worker concurrency
# instead of the per-scraper serial loop (src/flights/queue/*). Default off.
USE_QUEUE=0
QUEUE_CONCURRENCY=8
# M2: adaptive cadence — fleet-level AIMD over queue worker concurrency. A cycle
# where hosts pushed back halves the pool; a clean cycle climbs it back. Queue path only.
ADAPTIVE_CADENCE=0
# M2: cost-aware scheduling — monthly USD ceiling for proxy/compute. When set, the
# curl_cffi runner only escalates low-difficulty routes to residential/mobile proxy
# for HIGH-priority routes within budget, and degrades to datacenter when exhausted.
# Unset/0 = no metering, no escalation gating (src/flights/scheduling/cost-budget.ts).
COST_BUDGET_USD=
# M2: self-healing parser auto-repair — on a vision `layout_changed` verdict, ask the
# LLM (dormant w/o ANTHROPIC_API_KEY) for a fresh selector and validate before any
# hot-swap. Needs CANARY_VISION=1 to produce the signal (src/flights/healing/*).
PARSER_AUTOREPAIR=0
