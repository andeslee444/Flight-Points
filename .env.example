# Harbor Flights - Environment Variables

# ── Airline Credentials ──
# ANA Mileage Club credentials (required for ANA scraper)
ANA_USERNAME=
ANA_PASSWORD=

# Singapore Airlines KrisFlyer (required for SQ scraper)
SQ_KRISFLYER_ID=
SQ_KRISFLYER_PASSWORD=

# British Airways Executive Club (required for BA scraper)
BA_EXEC_CLUB_NUMBER=
BA_EXEC_CLUB_PASSWORD=

# Aeroplan / Air Canada (required for United via Aeroplan scraper)
AEROPLAN_USERNAME=
AEROPLAN_PASSWORD=

# United MileagePlus (optional — needed if united.com requires login for award search)
UNITED_USERNAME=        # MileagePlus number or email
UNITED_PASSWORD=

# Turkish Airlines API (register at developer.apim.turkishairlines.com)
TK_API_KEY=               # Turkish Airlines API key
TK_API_SECRET=            # Turkish Airlines API secret

# ── Daemon Configuration ──
# Path to shared web cache JSON for frontend display
WEB_CACHE_PATH=

# Comma-separated SCRAPER_REGISTRY keys the daemon is allowed to run
# (e.g. DAEMON_SCRAPERS=aa,flying-blue,jetblue). Empty/unset = all
# non-blocked active registry entries.
DAEMON_SCRAPERS=

# Days between sampled search dates (default: 14)
DATE_SAMPLING_DAYS=14

# Base directory for all data files (default: ./data)
DATA_DIR=

# ── Web Frontend ──
# Max age (hours) of flight_cache rows shown as current deals (default: 48)
DEAL_MAX_AGE_HOURS=48

# ── Caching ──
# Directory for disk-backed scraper cache (leave empty for in-memory only)
SCRAPER_CACHE_DIR=

# ── Database ──
# PostgreSQL connection URL (from Terraform output or local dev)
# Example: postgresql://flightadmin:password@flight-points.xxxx.us-east-1.rds.amazonaws.com:5432/flight_points?sslmode=require
DATABASE_URL=

# Set to "false" to disable SSL (for local dev only)
# PG_SSL=false

# ── Proxy ──
# SOCKS5 proxy for anti-detect browsers (e.g., socks5://127.0.0.1:1080)
PROXY_URL=

# ── Harbor SSE Proxy (for Vercel -> Harbor live search) ──
# URL of the Harbor Express server (required for live search SSE proxy)
# Example: http://150.136.249.186:3000 or http://harbor.local:3000
HARBOR_URL=
