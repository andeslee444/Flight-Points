# Harbor Flights - Environment Variables

# ── Airline Credentials ──
# seats.aero API key (optional — used by some scrapers as fallback)
SEATS_AERO_API_KEY=

# ANA Mileage Club credentials (required for ANA scraper)
ANA_USERNAME=
ANA_PASSWORD=

# Singapore Airlines KrisFlyer (required for SQ scraper)
SQ_KRISFLYER_ID=
SQ_KRISFLYER_PASSWORD=

# British Airways Executive Club (required for BA scraper)
BA_EXEC_CLUB_NUMBER=
BA_EXEC_CLUB_PASSWORD=

# Aeroplan / Air Canada (required for United via Aeroplan scraper)
AEROPLAN_USERNAME=
AEROPLAN_PASSWORD=

# ── Daemon Configuration ──
# Path to shared web cache JSON for frontend display
WEB_CACHE_PATH=

# Days between sampled search dates (default: 14)
DATE_SAMPLING_DAYS=14

# Base directory for all data files (default: ./data)
DATA_DIR=

# ── Caching ──
# Directory for disk-backed scraper cache (leave empty for in-memory only)
SCRAPER_CACHE_DIR=

# ── Database ──
# PostgreSQL connection URL (from Terraform output or local dev)
# Example: postgresql://flightadmin:password@flight-points.xxxx.us-east-1.rds.amazonaws.com:5432/flight_points?sslmode=require
DATABASE_URL=

# Set to "false" to disable SSL (for local dev only)
# PG_SSL=false

# ── Proxy ──
# SOCKS5 proxy for anti-detect browsers (e.g., socks5://127.0.0.1:1080)
PROXY_URL=
