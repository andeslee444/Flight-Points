{
  "buildCommand": "npm run vercel-build",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/flights.html" },
    { "source": "/flights", "destination": "/flights.html" },
    { "source": "/flight-results", "destination": "/flight-results.html" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" }
  ]
}
